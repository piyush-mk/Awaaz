# Awaaz v2 backend configuration. Copy to .env and fill in what you have.
# Every key is optional: with DEMO_MODE=auto the app falls back to fixtures.

# --- Sarvam AI (primary: STT, LLM, TTS, vision) ---
SARVAM_API_KEY=
SARVAM_API_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v4
SARVAM_LLM_MODEL=sarvam-105b
# bulbul:v4-flash voices look like simran_enhi_customer; bulbul:v3 voices look like ritu.
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=simran_enhi_customer
SARVAM_VISION_MODEL=gemma4

# --- OpenRouter (backup AI when Sarvam fails: chat/tool calling and vision) ---
# Credits are limited on the shared account (about $6), so keep max_tokens small and do not loop.
# Chain: Sarvam -> OpenRouter -> rules/fixture. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_VISION_MODEL=google/gemini-3.1-flash-lite

# --- WhatsApp Cloud API (Meta). Without these the in-app simulator is used ---
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=awaaz-verify
WA_APP_SECRET=

# --- Merchant and hosting ---
# UPI id that receives the demo QR payments (real money if scanned).
MERCHANT_UPI_VPA=paytm.merchant@paytm
MERCHANT_NAME=Ramesh General Store
# Public https URL of this backend (receipt links, WhatsApp webhook, CORS).
PUBLIC_BASE_URL=http://localhost:8000

# --- Behaviour ---
# auto = fixtures only when a key is missing or a call fails
# on   = never call external APIs, always use fixtures
# off  = never use fixtures; provider errors surface
DEMO_MODE=auto
# Default is sqlite:///<backend>/db.sqlite
DATABASE_URL=
